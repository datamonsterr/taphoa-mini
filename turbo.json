{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "lint": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false,
      "outputs": [],
      "env": ["DATABASE_URL", "REDIS_URL"]
    },
    "test:e2e": {
      "cache": false,
      "outputs": [],
      "env": ["BASE_URL", "EXPECT_SEGMENT_STATUS", "SEGMENT_EXPECTED_STATUS"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["EXPO_PUBLIC_API_URL"],
      "outputs": ["dist/**", "target/release/**"]
    }
  }
}
