# Local Compose defaults; development credentials only.
POSTGRES_USER=taphoa
POSTGRES_PASSWORD=taphoa
POSTGRES_DB=taphoa
POSTGRES_PORT=55432
REDIS_PORT=56379
BACKEND_PORT=8080
BACKEND_IMAGE=taphoa-mini-backend:dev
# 1 = no SAM weights in image (segmentation returns 503); 0 downloads weights.
SKIP_MODELS=1
RUST_LOG=info
# Physical device: replace localhost in both values with your host LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:8080
REACT_NATIVE_PACKAGER_HOSTNAME=localhost
# Host-side integration tests; Compose uses service names internally.
DATABASE_URL=postgres://taphoa:taphoa@localhost:55432/taphoa
REDIS_URL=redis://localhost:56379
