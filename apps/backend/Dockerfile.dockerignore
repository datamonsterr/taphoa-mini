# Dockerfile-specific ignore file applies when using the repository root context.
**
!apps/
!apps/backend/
!apps/backend/**
apps/backend/target/
apps/backend/target-local/
apps/backend/.cache/
# Worktree-specific target paths are not portable inside the build image.
apps/backend/.cargo/
apps/backend/models/
apps/backend/onnxruntime/
apps/backend/.env
