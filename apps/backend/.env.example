PORT=8080
DATABASE_URL=postgres://taphoa:taphoa@localhost:5432/taphoa
REDIS_URL=redis://localhost:6379
SAM_ENCODER_PATH=models/sam_vit_b_encoder.onnx
SAM_DECODER_PATH=models/sam_vit_b_decoder.onnx
# Absolute path; scripts/fetch-onnxruntime.sh prints the export for your checkout.
ORT_DYLIB_PATH=/absolute/path/to/apps/backend/onnxruntime/lib/libonnxruntime.so.1.23.2
RUST_LOG=taphoa_api=info,tower_http=info
# Docker sets JSON logs by default; use text locally.
LOG_FORMAT=text

# Optional: omit ALL five AWS_* variables to disable image routes.
# Local RustFS credentials only; use Railway variables for production secrets.
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=taphoa-local
AWS_SECRET_ACCESS_KEY=taphoa-local-secret
AWS_S3_BUCKET_NAME=images
AWS_DEFAULT_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
IMAGE_URL_TTL_SECONDS=900
# Optional if clients need a different host from the upload endpoint:
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
