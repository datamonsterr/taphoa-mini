PORT=8080
DATABASE_URL=postgres://taphoa:taphoa@localhost:5432/taphoa
REDIS_URL=redis://localhost:6379
# E2E only: pin the business clock (RFC 3339 with offset); unset uses wall time.
# Startup refuses this override when RAILWAY_ENVIRONMENT_NAME=production (case-insensitive).
# Affects next-step rules, server business dates and date defaults; client-supplied event
# times, authentication, audit timestamps and transport expiry still use their own clocks.
# TAPHOA_TEST_NOW=2026-01-15T10:00:00+07:00
# Clerk session JWTs are verified (RS256) against the JWKS of the Frontend API encoded in the
# publishable key; startup fails without CLERK_PUBLISHABLE_KEY (or CLERK_ISSUER). This is the
# development instance key: public by design, it ships in the app bundle.
CLERK_PUBLISHABLE_KEY=pk_test_ZnVsbC1tb2NjYXNpbi01NDA3LmNsZXJrLmFjY291bnRzLmRldiQ
# Optional Backend API key for profile reads (GET /v1/me). A secret: put your copy from
# ~/.config/taphoa-mini/secrets.env in `.env`, never commit it. Left commented out here; an empty
# value is treated as unset.
# CLERK_SECRET_KEY=
# Optional: Backend API base URL, and comma-separated origins checked against the token's azp
# claim (tokens minted with the Backend API carry none). CLERK_ISSUER and CLERK_JWKS_URL override
# the values derived from the publishable key (tests point them at a local stub).
# CLERK_API_URL=https://api.clerk.com
# CLERK_AUTHORIZED_PARTIES=
# Client address used for per-IP limits. `peer` (default) ignores all headers; behind
# Railway set `x-real-ip` (its edge injects X-Real-IP). `x-forwarded-for` takes the
# TRUSTED_PROXY_HOPS-th entry from the right. Never trust a client-set header.
CLIENT_IP_SOURCE=peer
TRUSTED_PROXY_HOPS=1
# Auth rate limits (spec defaults shown). Raise them for e2e/test environments only.
RATE_LIMIT_STORE_CREATE_PER_HOUR=10
RATE_LIMIT_JOIN_PER_HOUR=10
RATE_LIMIT_PIN_ATTEMPTS=5
SAM_ENCODER_PATH=models/mobile_sam_image_encoder.onnx
SAM_DECODER_PATH=models/sam_mask_decoder_multi.onnx
DINO_MODEL_PATH=models/dinov2_small.onnx
# Set all four OCR paths, or leave all unset to disable receipt OCR.
OCR_DET_PATH=models/ocr_det.onnx
OCR_ENCODER_PATH=models/ocr_vietocr_encoder.onnx
OCR_DECODER_PATH=models/ocr_vietocr_decoder.onnx
OCR_VOCAB_PATH=models/ocr_vietocr.json
OCR_THREADS=4
# Optional tuning: threads (0 = all cores), decoder sessions (0 = min(threads, 8)),
# prompt grid per side, decoder mask side.
# SAM_THREADS=0
# SAM_DECODERS=0
# ONNX Runtime thread spinning (default off): busy-waiting burns CPU quota and
# throttles the container. Set 1 or true only on hosts with idle cores to spare.
# ORT_SPINNING=0
# SAM_POINTS_PER_SIDE=8
# SAM_MASK_SIDE=256
# Embedder input side in pixels (multiple of 14, max 224); 112 fits the 3 s budget.
# EMBED_SIDE=112
# Recognition thresholds (cosine): match, margin over runner-up, floor, enrollment duplicate.
# MATCH_THRESHOLD=0.80
# MATCH_MARGIN=0.05
# MATCH_FLOOR=0.60
# DUPLICATE_THRESHOLD=0.88
# SCAN_MAX_DETECTIONS=24
# Absolute path; scripts/fetch-onnxruntime.sh prints the export for your checkout.
ORT_DYLIB_PATH=/absolute/path/to/apps/backend/onnxruntime/lib/libonnxruntime.so.1.23.2
RUST_LOG=taphoa_api=info,tower_http=info
# Docker sets JSON logs by default; use text locally.
LOG_FORMAT=text

# Optional: omit ALL five AWS_* variables to disable image routes.
# Local RustFS credentials only; use Railway variables for production secrets.
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=taphoa-local
AWS_SECRET_ACCESS_KEY=taphoa-local-secret
AWS_S3_BUCKET_NAME=images
AWS_DEFAULT_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
IMAGE_URL_TTL_SECONDS=900
# Optional if clients need a different host from the upload endpoint:
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# Assistant provider for local runs; Railway must use openrouter.
ASSISTANT_MODEL_PROVIDER=scripted
# Ordered free-only model fallbacks; configured separately in each Railway environment.
ASSISTANT_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# Maximum user messages per store per business day (default 60).
ASSISTANT_DAILY_MESSAGES_PER_STORE=60
# Enable pinned eval headers locally and on test only; never enable in production.
ASSISTANT_ALLOW_EVAL_HEADERS=1
# OpenRouter reasoning effort (default low).
ASSISTANT_REASONING_EFFORT=low
# Optional PostHog feedback survey id; blank disables survey integration.
ASSISTANT_FEEDBACK_SURVEY_ID=
# Optional PostHog rating question id; required with the survey id.
ASSISTANT_FEEDBACK_QUESTION_ID=
# Optional PostHog free-text feedback question id.
ASSISTANT_FEEDBACK_COMMENT_QUESTION_ID=
# OpenRouter chat completions endpoint (default shown; local mocks may override).
ASSISTANT_OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
# Maximum wait for the first model token, in milliseconds (default 20000).
ASSISTANT_FIRST_TOKEN_TIMEOUT_MS=20000
# Total timeout per model attempt, in milliseconds (default 60000).
ASSISTANT_MODEL_TIMEOUT_MS=60000

# Product analytics (disabled without a project token)
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST=https://us.i.posthog.com
