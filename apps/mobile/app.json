{
  "expo": {
    "name": "Tạp Hóa Mini",
    "slug": "taphoamini",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taphoa",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.datamonsterr.taphoamini"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c0c0e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.datamonsterr.taphoamini",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c0c0e",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Tạp Hóa Mini cần dùng máy ảnh để nhận diện hàng hóa và chụp ảnh sản phẩm.",
          "microphonePermission": "Tạp Hóa Mini cần dùng micro để ghi bán hàng bằng giọng nói và nói chuyện với trợ lý. / Tạp Hóa Mini uses the microphone to record sales by voice and talk to the assistant.",
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "./modules/voice-bubble/app.plugin.js",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Tạp Hóa Mini cần dùng micro để ghi bán hàng bằng giọng nói và nói chuyện với trợ lý. / Tạp Hóa Mini uses the microphone to record sales by voice and talk to the assistant.",
          "speechRecognitionPermission": "Tạp Hóa Mini cần nhận dạng giọng nói để chuyển lời bạn nói thành chữ cho trợ lý."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5a43e8",
          "defaultChannel": "digest"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Tạp Hóa Mini dùng tên và số điện thoại của liên hệ bạn chọn để tạo khách hàng."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Tạp Hóa Mini cần dùng micro để ghi bán hàng bằng giọng nói và nói chuyện với trợ lý. / Tạp Hóa Mini uses the microphone to record sales by voice and talk to the assistant.",
          "recordAudioAndroid": true
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "aacb6d3c-093a-4da0-ae2c-fbc9ce53a458"
      }
    },
    "owner": "datamonsters-team"
  }
}
