{
  "expo": {
    "name": "Tạp Hóa Mini",
    "slug": "taphoamini",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taphoa",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.datamonsterr.taphoamini"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c0c0e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.datamonsterr.taphoamini"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c0c0e",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Tạp Hóa Mini cần dùng máy ảnh để nhận diện hàng hóa và chụp ảnh sản phẩm.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "aacb6d3c-093a-4da0-ae2c-fbc9ce53a458"
      }
    },
    "owner": "datamonsters-team"
  }
}
