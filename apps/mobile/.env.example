# Base URL of the Tạp Hóa Mini backend (the app has no mock mode). Default: http://localhost:8080.
# Use your machine's LAN address for a physical phone, 10.0.2.2 for the Android emulator.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Clerk publishable key for mobile and web. Never put a secret key here.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
