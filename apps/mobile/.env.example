# Base URL of the Tạp Hóa Mini backend (the app has no mock mode). Default: http://localhost:8080.
# Use your machine's LAN address for a physical phone, 10.0.2.2 for the Android emulator.
EXPO_PUBLIC_API_URL=http://localhost:8080

# PostHog project token; leave empty to disable product analytics locally.
EXPO_PUBLIC_POSTHOG_KEY=
# PostHog ingestion endpoint.
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Environment super property attached to analytics.
EXPO_PUBLIC_ENVIRONMENT=local
# Clerk publishable key for mobile and web. Never put a secret key here.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Only for an explicitly invoked dedicated-store production smoke export.
EXPO_PUBLIC_SMOKE=0
