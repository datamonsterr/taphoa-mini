{
  "name": "@taphoa/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@shopify/flash-list": "2.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@taphoa/api-client": "workspace:*",
    "expo": "~58.0.17",
    "expo-asset": "~58.0.18",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-manipulator": "~58.0.15",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "lucide-react-native": "^1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-qrcode-svg": "^6.3.27",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo-mcp": "~0.2.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand && pnpm test:scripts",
    "test:e2e": "maestro test .maestro",
    "build": "expo export --platform android --output-dir dist",
    "build:web": "expo export --platform web --output-dir dist-web",
    "build:ios": "expo export --platform ios --output-dir dist-ios",
    "build:all": "pnpm build && pnpm build:web && pnpm build:ios",
    "test:coverage": "jest --runInBand --coverage && pnpm test:tz && pnpm test:scripts",
    "test:tz": "node scripts/test-tz.mjs",
    "test:scripts": "node --test 'scripts/**/*.test.mjs'",
    "start:go": "expo start --go",
    "test:e2e:web": "playwright test",
    "check:bundle": "node scripts/bundle-budget.mjs",
    "deploy:web": "pnpm build:web && eas deploy --export-dir dist-web",
    "deploy:web:prod": "pnpm build:web && eas deploy --export-dir dist-web --prod"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|standard-navigation|@react-navigation/.*|@shopify/flash-list))"
    ],
    "setupFiles": [
      "<rootDir>/src/test/setup.tsx"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.*",
      "!src/test/**",
      "!src/app/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "lines": 90,
        "functions": 90,
        "branches": 85
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/after-env.ts"
    ],
    "testTimeout": 20000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/e2e-web/",
      "<rootDir>/scripts/"
    ]
  }
}
