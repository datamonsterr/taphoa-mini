    "voice:synth": "node scripts/voice-synth.ts"
  },
  "dependencies": {
    "@taphoa/api-client": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@~7.0.2",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vitest": "^5.0.5"
