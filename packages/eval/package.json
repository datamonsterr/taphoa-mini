{
  "name": "@taphoa/eval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "validate": "node src/cli.ts validate",
    "oracles": "node src/cli.ts oracles",
    "smoke": "node src/cli.ts smoke",
    "full": "node src/cli.ts full",
    "compare": "node src/cli.ts compare",
    "calibrate": "node src/cli.ts calibrate",
